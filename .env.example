TELEGRAM_BOT_TOKEN=replace-with-your-botfather-token
BOT_TIMEZONE=Asia/Singapore
DEFAULT_DAILY_TIME=08:00
REMINDER_WARNING_MINUTES=60

# Required for conversational messages. Keep this secret.
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=20

# Cloud Run only. Generate a random value using letters, numbers, _ or -.
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
FIRESTORE_DATABASE=(default)
CLOUD_RUN_AUDIENCE=https://your-service-url.run.app
SCHEDULER_SERVICE_ACCOUNT=reminder-scheduler@your-project.iam.gserviceaccount.com
